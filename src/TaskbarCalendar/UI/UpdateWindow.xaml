<Window x:Class="TaskbarCalendar.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本更新 - 任务栏日历"
        Width="430"
        Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部版本信息头部 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Source="/Assets/app.ico" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,14,0" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Text="发现新版本 v1.2.0" />
                <TextBlock x:Name="SubTitleText" FontSize="12" Foreground="#666666" Margin="0,4,0,0" Text="当前版本: v1.1.0 · 发布日期: 2026-09-22" />
            </StackPanel>
        </Grid>

        <!-- 更新日志区域 -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ChangelogText" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="#333333" />
            </ScrollViewer>
        </Border>

        <!-- 下载进度区域（默认收起，点击下载后展示） -->
        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <ProgressBar x:Name="DownloadBar" Height="8" Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#0078D4" Margin="0,4,0,0" Text="正在下载更新包... 0%" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 底部按钮操作栏 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="前往官网" HorizontalAlignment="Left" Padding="10,6" Click="OnOpenWebsiteClick" />

            <Button Grid.Column="1" x:Name="CancelButton" Content="稍后再说" Padding="14,6" Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick" />
            <Button Grid.Column="2" x:Name="UpdateButton" Content="立即就地更新" FontWeight="SemiBold" Padding="16,6" Click="OnUpdateClick" />
        </Grid>
    </Grid>
</Window>
