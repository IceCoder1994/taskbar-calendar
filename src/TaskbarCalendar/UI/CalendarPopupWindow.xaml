<Window x:Class="TaskbarCalendar.UI.CalendarPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏日历"
        Width="360"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="-10000"
        Top="-10000"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnWindowMouseWheel">
    <Window.Resources>
        <!-- 默认深色主题资源；运行时按系统主题覆盖 -->
        <SolidColorBrush x:Key="AppBackground" Color="#F01F1F1F" />
        <SolidColorBrush x:Key="AppBorder" Color="#28FFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#B0FFFFFF" />
        <SolidColorBrush x:Key="MutedText" Color="#58FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
        <SolidColorBrush x:Key="AccentForeground" Color="#000000" />
        <SolidColorBrush x:Key="TodayBackground" Color="#334CC2FF" />
        <SolidColorBrush x:Key="WeekEndText" Color="#FF9E9E" />
        <SolidColorBrush x:Key="HoverBackground" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="DividerBrush" Color="#20FFFFFF" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayCellButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="10,8,10,10">
            <!-- 主视图 -->
            <Grid x:Name="MainView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部：翻月 / 年月选择 / 回到今天 -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource NavButtonStyle}"
                            Content="‹"
                            FontSize="17"
                            Click="OnPrevMonthClick" />
                    <Button x:Name="YearButton"
                            Grid.Column="1"
                            Style="{StaticResource NavButtonStyle}"
                            Content="2026年"
                            Click="OnYearClick" />
                    <Button x:Name="MonthButton"
                            Grid.Column="2"
                            Style="{StaticResource NavButtonStyle}"
                            Content="9月"
                            Click="OnMonthClick" />
                    <Button Grid.Column="3"
                            Style="{StaticResource NavButtonStyle}"
                            Content="›"
                            FontSize="17"
                            Click="OnNextMonthClick" />
                    <Button Grid.Column="5"
                            Style="{StaticResource NavButtonStyle}"
                            Content="今天"
                            Click="OnTodayClick" />
                </Grid>

                <!-- 星期表头 -->
                <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                    <TextBlock x:Name="WeekHeader0" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                    <TextBlock x:Name="WeekHeader1" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                    <TextBlock x:Name="WeekHeader2" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                    <TextBlock x:Name="WeekHeader3" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                    <TextBlock x:Name="WeekHeader4" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                    <TextBlock x:Name="WeekHeader5" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                    <TextBlock x:Name="WeekHeader6" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                </UniformGrid>

                <!-- 日期网格 -->
                <ItemsControl x:Name="DayGrid" Grid.Row="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DayCellButtonStyle}"
                                    Background="{Binding Background}"
                                    ToolTip="{Binding Tooltip}"
                                    Click="OnDayCellClick">
                                <Grid Margin="0,3">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DayText}"
                                                   Foreground="{Binding DayForeground}"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LunarText}"
                                                   Foreground="{Binding LunarForeground}"
                                                   FontSize="9"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Border Visibility="{Binding HolidayMarkVisibility}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-2,-2,0"
                                            CornerRadius="3"
                                            Padding="2,0"
                                            Background="{Binding HolidayMarkBackground}">
                                        <TextBlock Text="{Binding HolidayMark}"
                                                   Foreground="{Binding HolidayMarkForeground}"
                                                   FontSize="8" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 详情栏 -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="0,4,0,0"
                        Padding="2,8,2,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="DetailDateText"
                                       FontSize="13"
                                       Foreground="{DynamicResource PrimaryText}" />
                            <TextBlock x:Name="DetailLunarText"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                        <TextBlock x:Name="DetailExtraText"
                                   Grid.Column="1"
                                   MaxWidth="150"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 年份选择 -->
            <Grid x:Name="YearPickerView" Visibility="Collapsed" Background="{DynamicResource AppBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="4,0,0,6"
                           FontSize="12"
                           Text="选择年份"
                           Foreground="{DynamicResource SecondaryText}" />
                <ListBox x:Name="YearList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnYearSelected">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- 月份选择 -->
            <Grid x:Name="MonthPickerView" Visibility="Collapsed" Background="{DynamicResource AppBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="4,0,0,6"
                           FontSize="12"
                           Text="选择月份"
                           Foreground="{DynamicResource SecondaryText}" />
                <UniformGrid x:Name="MonthPickerGrid" Grid.Row="1" Columns="3" Rows="4" />
            </Grid>
        </Grid>
    </Border>
</Window>
