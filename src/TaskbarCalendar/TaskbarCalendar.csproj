<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标 .NET Framework 4.8：Win10/11 系统自带，用户无需安装任何运行时 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>任务栏日历</AssemblyTitle>
    <Product>任务栏日历插件</Product>
    <Version>1.1.0</Version>
    <!-- NuGet 依赖（System.Text.Json）在 .NET Framework 下需要绑定重定向 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!-- DPI 由 app.manifest 统一声明，压制 WinForms 分析器建议 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 下 UI Automation 需显式引用（.NET 8 由 WPF 框架自带） -->
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <!-- .NET Framework 下 HttpClient 与 Zip 压缩位于独立程序集 -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- JSON 读写（设置持久化与节假日数据），net462+ 兼容 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 节假日数据文件随程序输出 -->
    <None Update="Data\holidays.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 应用图标（托盘加载用） -->
    <None Update="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
